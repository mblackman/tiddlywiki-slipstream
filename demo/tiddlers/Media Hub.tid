title: Media Hub
tags: $:/tags/Pinned $:/tags/Slipstream/BottomBar Wide
caption: Media
ss-icon: 🎬
page-width: wide
modified: 20261016133000000
created: 20261016120000000

<$ss.hero title="Media Library" subtitle="User-space media gallery using generic $ss.grid and $ss.card widgets">
	<$fill $name="actions">
		<$button class="mn-btn-primary">
			<$action-sendmessage $message="tm-new-tiddler" tags="Media" media-type="Book" status="Reading"/>
			+ Log Media
		</$button>
	</$fill>
</$ss.hero>

<$ss.grid min="220px">
	<$list filter="[all[tiddlers]tag[Media]!has[draft.of]!sort[modified]limit[24]]">
		<$ss.card badge={{!!media-type}}>
			<div class="mn-prop-label"><$view field="creator"/> • ★ <$view field="rating"/></div>
			<$transclude mode="block"/>
		</$ss.card>
	</$list>
</$ss.grid>
