title: $:/core/ui/SideBar/Open
tags: $:/tags/SideBar
caption: {{$:/language/SideBar/Open/Caption}}
list-before: $:/core/ui/SideBar/Recent
type: text/vnd.tiddlywiki

\whitespace trim
\import [subfilter{$:/core/config/GlobalImportFilter}]
\procedure lingo-base() $:/language/CloseAll/
\procedure drop-actions()
<$action-listops $tiddler=<<storyList>> $subfilter="+[insertbefore<actionTiddler>,<currentTiddler>]"/>
\end
\function .active-tiddler() [list<storyList>match{<historyList>!!current-tiddler}] ~[list<storyList>first[]]

<$let
	storyList={{{ [<tv-story-list>!is[blank]else[$:/StoryList]] }}}
	historyList={{{ [<tv-history-list>!is[blank]else[$:/HistoryList]] }}}
>
<div class="tc-sidebar-tab-open">
<$list filter="[list<storyList>]" storyview="pop">
<div class="tc-sidebar-tab-open-item">
<$droppable actions=<<drop-actions>> enable=<<tv-enable-drag-and-drop>> tag="div">
<div class="tc-droppable-placeholder"/>
<div class={{{ [[mn-nav-item tc-sidebar-tab-open-row]] [<currentTiddler>match<.active-tiddler>then[mn-nav-item-active]] +[join[ ]] }}}>
<$link to=<<currentTiddler>> class="mn-card-title">
<$view field="caption"><$text text=<<currentTiddler>>/></$view>
</$link>
<$button message="tm-close-tiddler" param=<<currentTiddler>> tooltip={{$:/language/Buttons/Close/Hint}} aria-label={{$:/language/Buttons/Close/Caption}} class="tc-btn-invisible tc-btn-mini">✕</$button>
</div>
</$droppable>
</div>
</$list>
<$list filter="[list<storyList>limit[1]]" variable="hasOpenTiddlers">
<div class="tc-sidebar-tab-open-clear">
<$tiddler tiddler="">
<$droppable actions=<<drop-actions>> enable=<<tv-enable-drag-and-drop>> tag="div">
<div class="tc-droppable-placeholder"/>
<$button message="tm-close-all-tiddlers" class="tc-btn-invisible tc-btn-mini"><<lingo Button>></$button>
</$droppable>
</$tiddler>
</div>
</$list>
</div>
</$let>
