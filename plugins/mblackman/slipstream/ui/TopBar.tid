title: $:/plugins/mblackman/slipstream/ui/TopBar
type: text/vnd.tiddlywiki

\whitespace trim
\function .breakpoint() [{$:/config/slipstream/mobile-breakpoint}!is[blank]else[1024]]
\function .is-mobile() [{$:/info/browser/window/system/main/client/width}!is[blank]compare:number:lt<.breakpoint>then[yes]else[no]]
\function .is-left-open() [.is-mobile[]match[yes]] :then[{$:/state/slipstream/left-panel}match[yes]then[yes]else[no]] :else[{$:/state/slipstream/left-panel}match[no]then[no]else[yes]]
\function .active-tiddler() [list[$:/StoryList]match{$:/HistoryList!!current-tiddler}] ~[list[$:/StoryList]first[]]

\procedure search-enter-actions()
<$let firstMatch={{{ [all[tiddlers]!is[system]!has[draft.of]search{$:/temp/volatile/slipstream/global-search}sort[title]first[]] }}}>
	<%if [<firstMatch>!is[blank]] %>
		<$action-navigate $to=<<firstMatch>>/>
		<$action-setfield $tiddler="$:/temp/volatile/slipstream/global-search" text="" $timestamp="no"/>
		<$action-setfield $tiddler="$:/state/slipstream/mobile-search" text="closed" $timestamp="no"/>
	<%endif%>
</$let>
\end

\procedure search-escape-actions()
<$action-setfield $tiddler="$:/temp/volatile/slipstream/global-search" text="" $timestamp="no"/>
<$action-setfield $tiddler="$:/state/slipstream/mobile-search" text="closed" $timestamp="no"/>
\end

<%if [{$:/state/slipstream/mobile-search}match[open]] %>
	<!-- Active Mobile Search Overlay in TopBar -->
	<div class="mn-topbar-mobile-search">
		<$button
			set="$:/state/slipstream/mobile-search"
			setTo="closed"
			class="mn-pill-btn"
			tooltip="Close Search"
		>
			✕
		</$button>
		<div class="mn-topbar-mobile-search-field">
			<$keyboard key="escape" actions=<<search-escape-actions>>>
				<$keyboard key="enter" actions=<<search-enter-actions>>>
					<$edit-text
						tiddler="$:/temp/volatile/slipstream/global-search"
						field="text"
						tag="input"
						type="search"
						placeholder="Search notes..."
						class="mn-search-input mn-mobile-search-input"
						focus="true"
					/>
				</$keyboard>
			</$keyboard>
			<%if [{$:/temp/volatile/slipstream/global-search}minlength[1]] %>
				<div class="mn-search-dropdown">
					<div class="mn-nav-heading">
						<span>Search Results</span>
						<$button set="$:/temp/volatile/slipstream/global-search" setTo="" class="tc-btn-invisible">✕</$button>
					</div>
					<$list
						filter="[all[tiddlers]!is[system]!has[draft.of]search{$:/temp/volatile/slipstream/global-search}sort[title]limit[12]]"
						emptyMessage="<div class='mn-prop-label' style='padding:0.4rem 0.65rem;'>No matching tiddlers found.</div>"
					>
						<$button to=<<currentTiddler>> class="mn-nav-item tc-btn-invisible">
							<span><$view field="caption"><$view field="title"/></$view></span>
							<span class="mn-prop-label"><$view field="modified" format="relativedate"/></span>
						</$button>
					</$list>
				</div>
			<%endif%>
		</div>
	</div>
<%else%>
	<!-- Standard Left Brand & Navigation Toggle -->
	<div class="mn-topbar-left">
		<$button
			set="$:/state/slipstream/left-panel"
			setTo={{{ [.is-left-open[]match[yes]then[no]else[yes]] }}}
			class={{{ [[mn-pill-btn]] [.is-left-open[]match[yes]then[mn-pill-btn-subtle-active]] +[join[ ]] }}}
			tooltip="Toggle Navigation"
		>
			☰
		</$button>
		<span class="mn-site-brand">
			<$link to=<<.active-tiddler>> class="mn-brand-title">
				<$text text={{{ [{$:/SiteTitle}!is[blank]else[Slipstream]] }}}/>
			</$link>
			<%if [.active-tiddler[]!is[blank]] %>
				<span class="mn-breadcrumb-sep mn-desktop-only">/</span>
				<span class="mn-breadcrumb-current mn-desktop-only"><$text text=<<.active-tiddler>>/></span>
			<%endif%>
		</span>
	</div>

	<!-- Desktop Center Search Input -->
	<div class="mn-topbar-center mn-desktop-only">
		<$keyboard key="escape" actions=<<search-escape-actions>>>
			<$keyboard key="enter" actions=<<search-enter-actions>>>
				<$edit-text
					tiddler="$:/temp/volatile/slipstream/global-search"
					field="text"
					tag="input"
					type="search"
					placeholder="Search or jump to note..."
					class="mn-search-input"
				/>
			</$keyboard>
		</$keyboard>
		<%if [{$:/temp/volatile/slipstream/global-search}minlength[1]] %>
			<div class="mn-search-dropdown">
				<div class="mn-nav-heading">
					<span>Search Results</span>
					<$button set="$:/temp/volatile/slipstream/global-search" setTo="" class="tc-btn-invisible">✕</$button>
				</div>
				<$list
					filter="[all[tiddlers]!is[system]!has[draft.of]search{$:/temp/volatile/slipstream/global-search}sort[title]limit[12]]"
					emptyMessage="<div class='mn-prop-label' style='padding:0.4rem 0.65rem;'>No matching tiddlers found.</div>"
				>
					<$button to=<<currentTiddler>> class="mn-nav-item tc-btn-invisible">
						<span><$view field="caption"><$view field="title"/></$view></span>
						<span class="mn-prop-label"><$view field="modified" format="relativedate"/></span>
					</$button>
				</$list>
			</div>
		<%endif%>
	</div>

	<!-- TopBar Right Controls: Desktop Right Inspector Toggle vs Mobile Search Button -->
	<div class="mn-topbar-right">
		<!-- Desktop-Only: Right Context Inspector Toggle -->
		<$button
			set="$:/state/slipstream/right-panel"
			setTo={{{ [{$:/state/slipstream/right-panel}match[no]then[yes]else[no]] }}}
			class={{{ [[mn-pill-btn mn-desktop-only mn-topbar-context-btn]] [{$:/state/slipstream/right-panel}!match[no]then[mn-pill-btn-subtle-active]] +[join[ ]] }}}
			tooltip="Toggle Right Context Inspector (Backlinks, Outline, Fields)"
			aria-label="Toggle Context Inspector"
		>
			<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-1px;">
				<rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
				<line x1="15" y1="3" x2="15" y2="21"/>
			</svg>
			<span>Context</span>
			<%if [.active-tiddler[]backlinks[]!is[system]count[]compare:number:gt[0]] %>
				<span class="mn-topbar-badge"><$text text={{{ [.active-tiddler[]backlinks[]!is[system]count[]] }}}/></span>
			<%endif%>
		</$button>

		<!-- Mobile-Only: Pin / Favorite Active Note Button -->
		<%if [.is-mobile[]match[yes]] :and[.active-tiddler[]!is[blank]] %>
			<$let activeTid=<<.active-tiddler>>>
				<$button
					class={{{ [[mn-pill-btn mn-mobile-only mn-pin-btn]] [<activeTid>tag[$:/tags/Pinned]then[mn-pill-btn-subtle-active]] +[join[ ]] }}}
					tooltip={{{ [<activeTid>tag[$:/tags/Pinned]then[Unpin note from shortcuts]else[Pin note to shortcuts]] }}}
					aria-label="Pin note"
				>
					<%if [<activeTid>tag[$:/tags/Pinned]] %>
						<$action-listops $tiddler=<<activeTid>> $tags="-[[$:/tags/Pinned]]"/>
						<span class="mn-pin-active-star" style="color:var(--mn-accent);font-size:1.05rem;line-height:1;">★</span>
					<%else%>
						<$action-listops $tiddler=<<activeTid>> $tags="[[$:/tags/Pinned]]"/>
						<span class="mn-pin-inactive-star" style="color:var(--mn-text-muted);font-size:1.05rem;line-height:1;">☆</span>
					<%endif%>
				</$button>
			</$let>
		<%endif%>
	</div>
<%endif%>
