title: $:/plugins/mblackman/slipstream/ui/MobileBar
type: text/vnd.tiddlywiki

\whitespace trim
\function .active-tiddler() [list[$:/StoryList]match{$:/HistoryList!!current-tiddler}] ~[list[$:/StoryList]first[]]
\function .is-draft() [.active-tiddler[]has[draft.of]then[yes]else[no]]
\function .has-active() [.active-tiddler[]!is[blank]then[yes]else[no]]
\function .backlinks-count() [.active-tiddler[]backlinks[]!is[system]count[]]
\function folded-state() [[$:/state/folded/]addsuffix<currentTiddler>]
\define cancel-delete-tiddler-actions(message) <$action-setfield $tiddler="$:/state/slipstream/mobile-action-sheet" text="closed"/><$action-sendmessage $message="tm-$message$-tiddler" $param=<<currentTiddler>>/>
\define close-and-forward(message)
<$action-setfield $tiddler="$:/state/slipstream/mobile-action-sheet" text="closed"/>
<$action-sendmessage
	$message="$message$"
	$param={{{ [<event-param>!is[blank]else<event-tiddlerTitle>!is[blank]else<currentTiddler>] }}}
	$names="[<list-event-paramObject>enlist-input[]]"
	$values="[<list-event-paramObject>enlist-input[]] :map[[event-paramObject-]addsuffix<currentTiddler>getvariable[]]"
/>
\end
\procedure close-sheet-actions()
<$action-setfield $tiddler="$:/state/slipstream/mobile-action-sheet" text="closed"/>
\end
\procedure slipstream-mobile-bar()
<nav class="mn-mobile-bottombar" aria-label="Mobile Controls">
	<%if [.is-draft[]match[yes]] %>
		<!-- Draft / Edit Mode Controls -->
		<$button message="tm-cancel-tiddler" param=<<.active-tiddler>> set="$:/state/slipstream/mobile-action-sheet" setTo="closed" class="mn-mobile-nav-btn mn-mobile-nav-btn-cancel" tooltip="Cancel changes">
			<span class="mn-mobile-nav-icon-wrap" aria-hidden="true">
				<svg class="mn-nav-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
					<line x1="18" y1="6" x2="6" y2="18"/>
					<line x1="6" y1="6" x2="18" y2="18"/>
				</svg>
			</span>
			<span class="mn-nav-label">Cancel</span>
		</$button>

		<$button message="tm-save-tiddler" param=<<.active-tiddler>> set="$:/state/slipstream/mobile-action-sheet" setTo="closed" class="mn-mobile-nav-btn mn-mobile-nav-btn-save" tooltip="Save note changes">
			<span class="mn-mobile-nav-icon-wrap" aria-hidden="true">
				<svg class="mn-nav-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
					<polyline points="20 6 9 17 4 12"/>
				</svg>
			</span>
			<span class="mn-nav-label">Save</span>
		</$button>

		<$button message="tm-delete-tiddler" param=<<.active-tiddler>> set="$:/state/slipstream/mobile-action-sheet" setTo="closed" class="mn-mobile-nav-btn mn-mobile-nav-btn-danger" tooltip="Discard draft">
			<span class="mn-mobile-nav-icon-wrap" aria-hidden="true">
				<svg class="mn-nav-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<polyline points="3 6 5 6 21 6"/>
					<path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
					<line x1="10" y1="11" x2="10" y2="17"/>
					<line x1="14" y1="11" x2="14" y2="17"/>
				</svg>
			</span>
			<span class="mn-nav-label">Discard</span>
		</$button>
	<%elseif [.has-active[]match[yes]] %>
		<!-- Active Note Reading Controls -->
		<!-- 1. Instant 1-Tap Edit -->
		<$button message="tm-edit-tiddler" param=<<.active-tiddler>> class="mn-mobile-nav-btn" tooltip="Edit this note">
			<span class="mn-mobile-nav-icon-wrap" aria-hidden="true">
				<svg class="mn-nav-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M12 20h9"/>
					<path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>
				</svg>
			</span>
			<span class="mn-nav-label">Edit</span>
		</$button>

		<!-- 2. Active Note Context / Inspector (Backlinks, Outline, Fields) -->
		<$button
			set="$:/state/slipstream/mobile-context-sheet"
			setTo={{{ [{$:/state/slipstream/mobile-context-sheet}match[open]then[closed]else[open]] }}}
			class={{{ [[mn-mobile-nav-btn]] [{$:/state/slipstream/mobile-context-sheet}match[open]then[mn-mobile-nav-btn-active]] +[join[ ]] }}}
			tooltip="Note Context (Backlinks, Outline, Fields)"
		>
			<span class="mn-mobile-nav-icon-wrap" aria-hidden="true">
				<svg class="mn-nav-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
					<line x1="15" y1="3" x2="15" y2="21"/>
				</svg>
				<%if [.backlinks-count[]compare:number:gt[0]] %>
					<span class="mn-mobile-badge"><$text text=<<.backlinks-count>>/></span>
				<%endif%>
			</span>
			<span class="mn-nav-label">Context</span>
		</$button>

		<!-- 3. Primary Center Quick Capture -->
		<$button message="tm-new-tiddler" class="mn-mobile-nav-btn mn-mobile-nav-btn-primary" tooltip="New note">
			<span class="mn-mobile-nav-icon-wrap" aria-hidden="true">
				<svg class="mn-nav-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
					<line x1="12" y1="5" x2="12" y2="19"/>
					<line x1="5" y1="12" x2="19" y2="12"/>
				</svg>
			</span>
			<span class="mn-nav-label">New</span>
		</$button>

		<!-- 4. Global Quick Search Trigger -->
		<$button
			set="$:/state/slipstream/mobile-search"
			setTo={{{ [{$:/state/slipstream/mobile-search}match[open]then[closed]else[open]] }}}
			class={{{ [[mn-mobile-nav-btn]] [{$:/state/slipstream/mobile-search}match[open]then[mn-mobile-nav-btn-active]] +[join[ ]] }}}
			tooltip="Search notes"
		>
			<span class="mn-mobile-nav-icon-wrap" aria-hidden="true">
				<svg class="mn-nav-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<circle cx="11" cy="11" r="8"/>
					<line x1="21" y1="21" x2="16.65" y2="16.65"/>
				</svg>
			</span>
			<span class="mn-nav-label">Search</span>
		</$button>

		<!-- 5. Secondary Actions Sheet Trigger (•••) -->
		<$button
			set="$:/state/slipstream/mobile-action-sheet"
			setTo={{{ [{$:/state/slipstream/mobile-action-sheet}match[open]then[closed]else[open]] }}}
			class={{{ [[mn-mobile-nav-btn]] [{$:/state/slipstream/mobile-action-sheet}match[open]then[mn-mobile-nav-btn-active]] +[join[ ]] }}}
			tooltip="More note actions"
		>
			<span class="mn-mobile-nav-icon-wrap" aria-hidden="true">
				<svg class="mn-nav-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
					<circle cx="12" cy="12" r="1.2" fill="currentColor"/>
					<circle cx="19" cy="12" r="1.2" fill="currentColor"/>
					<circle cx="5" cy="12" r="1.2" fill="currentColor"/>
				</svg>
			</span>
			<span class="mn-nav-label">More</span>
		</$button>
	<%else%>
		<!-- Empty Story River Fallback Controls -->
		<$button set="$:/state/slipstream/left-panel" setTo="yes" class="mn-mobile-nav-btn" tooltip="Open navigation">
			<span class="mn-mobile-nav-icon-wrap" aria-hidden="true">
				<svg class="mn-nav-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<line x1="3" y1="12" x2="21" y2="12"/>
					<line x1="3" y1="6" x2="21" y2="6"/>
					<line x1="3" y1="18" x2="21" y2="18"/>
				</svg>
			</span>
			<span class="mn-nav-label">Navigate</span>
		</$button>

		<$button message="tm-new-tiddler" class="mn-mobile-nav-btn mn-mobile-nav-btn-primary" tooltip="New note">
			<span class="mn-mobile-nav-icon-wrap" aria-hidden="true">
				<svg class="mn-nav-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
					<line x1="12" y1="5" x2="12" y2="19"/>
					<line x1="5" y1="12" x2="19" y2="12"/>
				</svg>
			</span>
			<span class="mn-nav-label">New</span>
		</$button>

		<$button set="$:/state/slipstream/mobile-search" setTo="open" class="mn-mobile-nav-btn" tooltip="Search notes">
			<span class="mn-mobile-nav-icon-wrap" aria-hidden="true">
				<svg class="mn-nav-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<circle cx="11" cy="11" r="8"/>
					<line x1="21" y1="21" x2="16.65" y2="16.65"/>
				</svg>
			</span>
			<span class="mn-nav-label">Search</span>
		</$button>
	<%endif%>
</nav>

<!-- Context Inspector Sheet (Backlinks, Outline, Fields) -->
<%if [{$:/state/slipstream/mobile-context-sheet}match[open]then<.has-active>match[yes]then<.is-draft>match[no]] %>
	<div class="mn-backdrop">
		<$button set="$:/state/slipstream/mobile-context-sheet" setTo="closed" class="mn-backdrop-dismiss tc-btn-invisible" aria-label="Close context sheet"/>
		<section class="mn-bottom-sheet" role="dialog" aria-modal="true" aria-label="Note Context">
			<$let zoomedTiddler=<<.active-tiddler>>>
				<$tiddler tiddler=<<zoomedTiddler>>>
					<header class="mn-card-header mn-bottom-sheet-header">
						<div>
							<div class="mn-nav-heading">Note Context</div>
							<div class="mn-card-title"><$view field="caption"><$view field="title"/></$view></div>
						</div>
						<div>
							<$button set="$:/state/slipstream/mobile-context-sheet" setTo="closed" class="mn-pill-btn">Done ✕</$button>
						</div>
					</header>

					<div class="mn-sheet-context">
						{{$:/plugins/mblackman/slipstream/ui/RightInspector}}
					</div>
				</$tiddler>
			</$let>
		</section>
	</div>
<%endif%>

<!-- Slide-Up Bottom Sheet for Secondary Tiddler Actions (•••) -->
<%if [{$:/state/slipstream/mobile-action-sheet}match[open]then<.has-active>match[yes]then<.is-draft>match[no]] %>
	<div class="mn-backdrop">
		<$button set="$:/state/slipstream/mobile-action-sheet" setTo="closed" class="mn-backdrop-dismiss tc-btn-invisible" aria-label="Close options sheet"/>
		<section class="mn-bottom-sheet" role="dialog" aria-modal="true" aria-label="Note Actions">
			<$let zoomedTiddler=<<.active-tiddler>>>
				<$tiddler tiddler=<<zoomedTiddler>>>
					<$let targetTemplate={{{ [<currentTiddler>] :cascade[all[shadows+tiddlers]tag[$:/tags/StoryTiddlerTemplateFilter]!is[draft]get[text]] :and[has[title]else[$:/core/ui/ViewTemplate]] }}}>
						<$vars transclusion={{{ [[{]] [<currentTiddler>] [[|$:/core/ui/StoryTiddlerTemplate|||}]] +[join[]] }}}>
							<$vars transclusion={{{ [[{]] [<currentTiddler>] [[|]] [<targetTemplate>] [[|||}]] +[join[]] }}}>
								<$vars storyTiddler=<<currentTiddler>> tiddlerInfoState=<<qualify "$:/state/popup/tiddler-info">>>
									<header class="mn-card-header mn-bottom-sheet-header">
										<div>
											<div class="mn-nav-heading">Note Actions</div>
											<div class="mn-card-title"><$view field="caption"><$view field="title"/></$view></div>
										</div>
										<div>
											<$button set="$:/state/slipstream/mobile-action-sheet" setTo="closed" class="mn-pill-btn">Done ✕</$button>
										</div>
									</header>

									<!-- Secondary ViewToolbar Buttons Rendered as Touch Grid -->
									<div class="mn-sheet-action-grid">
										<$messagecatcher
											$tm-new-tiddler=<<close-and-forward "tm-new-tiddler">>
											$tm-edit-tiddler=<<close-and-forward "tm-edit-tiddler">>
											$tm-close-tiddler=<<close-and-forward "tm-close-tiddler">>
											$tm-close-other-tiddlers=<<close-and-forward "tm-close-other-tiddlers">>
											$tm-permalink=<<close-and-forward "tm-permalink">>
											$tm-permaview=<<close-and-forward "tm-permaview">>
											$tm-open-window=<<close-and-forward "tm-open-window">>
											$tm-fold-tiddler=<<close-and-forward "tm-fold-tiddler">>
											$tm-fold-other-tiddlers=<<close-and-forward "tm-fold-other-tiddlers">>
											$tm-download-file=<<close-and-forward "tm-download-file">>
										>
											<$let tv-config-toolbar-icons="yes" tv-config-toolbar-text="yes">
												<$list filter="[all[shadows+tiddlers]tag[$:/tags/ViewToolbar]!has[draft.of]] -[[$:/core/ui/Buttons/fold-bar]] -[[$:/core/ui/Buttons/more-tiddler-actions]]" variable="toolbarItem">
													<$let condition={{{ [<toolbarItem>get[condition]] }}}>
														<%if [<condition>!is[blank]] :and[<currentTiddler>subfilter<condition>limit[1]] :else[<condition>is[blank]then[true]] %>
															<div class="mn-sheet-action-item">
																<$set name="tv-config-toolbar-class" filter="[<tv-config-toolbar-class>] [<toolbarItem>encodeuricomponent[]addprefix[tc-btn-]]">
																	<%if [<toolbarItem>match[$:/core/ui/Buttons/info]] %>
																		<$eventcatcher selector="button" $click=<<close-sheet-actions>> stopPropagation="never" tag="div" class="mn-sheet-action-fill">
																			<$transclude $tiddler=<<toolbarItem>> mode="inline"/>
																		</$eventcatcher>
																	<%else%>
																		<$transclude $tiddler=<<toolbarItem>> mode="inline"/>
																	<%endif%>
																</$set>
															</div>
														<%endif%>
													</$let>
												</$list>
											</$let>
										</$messagecatcher>
									</div>
								</$vars>
							</$vars>
						</$vars>
					</$let>
				</$tiddler>
			</$let>
		</section>
	</div>
<%endif%>
\end
<$transclude $variable="slipstream-mobile-bar"/>

