title: $:/plugins/mblackman/slipstream/settings
tags: $:/tags/ControlPanel/SettingsTab
caption: Slipstream
type: text/vnd.tiddlywiki

\whitespace trim
\procedure default-pinned-filter() [all[shadows+tiddlers]tag[$:/tags/Pinned]!has[draft.of]]
\function .pinned-filter() [{$:/config/slipstream/pinned-filter}!is[blank]else<default-pinned-filter>]
<h3>Slipstream Settings</h3>
<p class="mn-prop-label">Configure desktop workspace modes, navigation filters, reading dimensions, and header metadata.</p>

<div class="mn-card" style="margin-bottom:1rem; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.75rem;">
	<div>
		<strong>Need reference guides or widget examples?</strong>
		<div class="mn-prop-label">Learn how to customize pinned shortcuts, inspector tabs, and responsive UI primitives.</div>
	</div>
	<$button class="mn-pill-btn" to="$:/plugins/mblackman/slipstream/docs">
		📚 Open Knowledge Base & Reference
	</$button>
</div>

<div class="mn-card" style="margin-bottom:1rem;">
	<h4 class="mn-nav-heading">Workspace & Reading Modes</h4>
	<div class="mn-object-prop-bar">
		<label class="mn-prop-label" style="min-width:240px;">Desktop Workspace Mode:</label>
		<$select tiddler="$:/config/slipstream/desktop-mode" default="document" class="mn-select">
			<option value="document">Focused Document (Default: single note with pinned header and sidebar switcher)</option>
			<option value="river">Story River (Traditional multi-note vertical river)</option>
		</$select>
	</div>
	<div class="mn-object-prop-bar">
		<label class="mn-prop-label" style="min-width:240px;">Storyview Transition:</label>
		<$select tiddler="$:/config/slipstream/storyview-override" default="auto" class="mn-select">
			<option value="auto">Automatic (Cross-fade in Focused Document and mobile; classic in Story River)</option>
			<option value="fade">Cross-Fade (Smooth transition between active notes)</option>
			<option value="classic">Classic (Standard vertical river)</option>
		</$select>
	</div>
	<div class="mn-object-prop-bar">
		<label class="mn-prop-label" style="min-width:240px;">When Closing a Note:</label>
		<$select tiddler="$:/config/slipstream/close-tiddler-target" default="previous" class="mn-select">
			<option value="previous">Return to Previously Opened Note (Default: navigation history)</option>
			<option value="story">Adjacent Note in Story List (Current river order)</option>
		</$select>
	</div>
</div>

<div class="mn-card" style="margin-bottom:1rem;">
	<h4 class="mn-nav-heading">Layout Dimensions & Responsive Breakpoints</h4>
	<div class="mn-object-prop-bar">
		<label class="mn-prop-label" style="min-width:240px;">Centered Reading Width:</label>
		<$edit-text tiddler="$:/config/slipstream/reading-width" field="text" default="840px" tag="input" class="mn-search-input"/>
	</div>
	<div class="mn-object-prop-bar">
		<label class="mn-prop-label" style="min-width:240px;">Wide Layout Width:</label>
		<$edit-text tiddler="$:/config/slipstream/wide-width" field="text" default="1120px" tag="input" class="mn-search-input"/>
	</div>
	<div class="mn-object-prop-bar">
		<label class="mn-prop-label" style="min-width:240px;">Left Sidebar Width (This Device):</label>
		<$edit-text tiddler="$:/state/slipstream/left-width" default="272px" tag="input" class="mn-search-input" placeholder="272px"/>
	</div>
	<div class="mn-object-prop-bar">
		<label class="mn-prop-label" style="min-width:240px;">Right Inspector Width (This Device):</label>
		<$edit-text tiddler="$:/state/slipstream/right-width" default="272px" tag="input" class="mn-search-input" placeholder="272px"/>
	</div>
	<p class="mn-prop-label" style="margin:0.25rem 0 0.5rem;font-size:0.76rem;">Sidebar widths are saved locally per browser so each device keeps its own dimensions without syncing across other screens.</p>
	<div class="mn-object-prop-bar">
		<label class="mn-prop-label" style="min-width:240px;">Mobile Breakpoint (px):</label>
		<$edit-text tiddler="$:/config/slipstream/mobile-breakpoint" field="text" default="1024" tag="input" class="mn-search-input"/>
	</div>
</div>

<div class="mn-card" style="margin-bottom:1rem;">
	<h4 class="mn-nav-heading">Navigation, Filters & Metadata</h4>
	<div class="mn-object-prop-bar">
		<label class="mn-prop-label" style="min-width:240px;">Pinned Shortcuts Filter:</label>
		<$edit-text tiddler="$:/config/slipstream/pinned-filter" field="text" default="[all[shadows+tiddlers]tag[$:/tags/Pinned]!has[draft.of]]" tag="input" class="mn-search-input"/>
	</div>
	<div style="margin:0.75rem 0;padding:0.75rem 0.9rem;border-radius:var(--mn-radius-sm);background:var(--mn-bg-subtle, var(--mn-bg-elevated));border:1px solid var(--mn-border-subtle);">
		<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.4rem;">
			<span style="font-weight:600;font-size:0.84rem;">Reorder Pinned Shortcuts</span>
			<span class="mn-prop-label"><$count filter="[subfilter<.pinned-filter>]"/> items</span>
		</div>
		<p class="mn-prop-label" style="margin-top:0;margin-bottom:0.6rem;line-height:1.4;">
			Reorder pinned shortcuts below or drag-and-drop them directly in the Left Navigation sidebar. The order is automatically saved into <code>$:/tags/Pinned</code> and syncs between devices.
		</p>
		<$set name="currentOrder" filter="[subfilter<.pinned-filter>sortby{$:/tags/Pinned!!list}]">
			<$list filter="[enlist<currentOrder>]" variable="pinItem" emptyMessage="<p class='mn-prop-label' style='margin:0;'>No notes currently tagged <code>$:/tags/Pinned</code>.</p>">
				<$let
					prev={{{ [enlist<currentOrder>before<pinItem>] }}}
					next={{{ [enlist<currentOrder>after<pinItem>] }}}
					nextAfter={{{ [enlist<currentOrder>after<next>] }}}
				>
					<div class="mn-nav-item" style="background:var(--mn-bg-surface);border:1px solid var(--mn-border-subtle);margin-bottom:0.35rem;padding:0.35rem 0.6rem;display:flex;align-items:center;justify-content:flex-start;text-align:left;">
						<span style="display:inline-flex;align-items:center;justify-content:flex-start;gap:0.45rem;min-width:0;flex:1 1 auto;text-align:left;">
							<%if [<pinItem>get[ss-icon]!is[blank]] %>
								<span style="flex-shrink:0;"><$text text={{{ [<pinItem>get[ss-icon]] }}}/></span>
							<%elseif [<pinItem>get[mn-icon]!is[blank]] %>
								<span style="flex-shrink:0;"><$text text={{{ [<pinItem>get[mn-icon]] }}}/></span>
							<%elseif [<pinItem>get[icon]!is[blank]] %>
								<span style="flex-shrink:0;"><$transclude $tiddler={{{ [<pinItem>get[icon]] }}}/></span>
							<%endif%>
							<span style="font-weight:500;text-align:left;"><$view tiddler=<<pinItem>> field="caption"><$text text=<<pinItem>>/></$view></span>
						</span>
						<span style="display:inline-flex;align-items:center;gap:0.25rem;margin-left:auto;flex-shrink:0;">
							<%if [<prev>!is[blank]] %>
								<$button class="mn-pill-btn tc-btn-mini mn-pin-action-btn" tooltip={{{ [<pinItem>addprefix[Move up ]] }}} aria-label={{{ [<pinItem>addprefix[Move up ]] }}}>
									<$action-listops $tiddler="$:/tags/Pinned" $field="list" $filter="[enlist<currentOrder>] +[insertbefore<pinItem>,<prev>]"/>
									↑
								</$button>
							<%else%>
								<span class="mn-pill-btn tc-btn-mini mn-pin-action-btn mn-pin-action-disabled" style="opacity:0.25;cursor:default;" aria-hidden="true">↑</span>
							<%endif%>
							<%if [<next>!is[blank]] %>
								<$button class="mn-pill-btn tc-btn-mini mn-pin-action-btn" tooltip={{{ [<pinItem>addprefix[Move down ]] }}} aria-label={{{ [<pinItem>addprefix[Move down ]] }}}>
									<%if [<nextAfter>!is[blank]] %>
										<$action-listops $tiddler="$:/tags/Pinned" $field="list" $filter="[enlist<currentOrder>] +[insertbefore<pinItem>,<nextAfter>]"/>
									<%else%>
										<$action-listops $tiddler="$:/tags/Pinned" $field="list" $filter="[enlist<currentOrder>] +[insertbefore:end<pinItem>]"/>
									<%endif%>
									↓
								</$button>
							<%else%>
								<span class="mn-pill-btn tc-btn-mini mn-pin-action-btn mn-pin-action-disabled" style="opacity:0.25;cursor:default;" aria-hidden="true">↓</span>
							<%endif%>
							<$button class="mn-pill-btn tc-btn-mini mn-pin-action-btn" tooltip={{{ [<pinItem>addprefix[Unpin ]] }}} aria-label={{{ [<pinItem>addprefix[Unpin ]] }}}>
								<$action-listops $tiddler=<<pinItem>> $tags="-[[$:/tags/Pinned]]"/>
								<$action-listops $tiddler="$:/tags/Pinned" $field="list" $subfilter="-[<pinItem>]"/>
								✕
							</$button>
						</span>
					</div>
				</$let>
			</$list>
		</$set>
	</div>
	<div class="mn-object-prop-bar">
		<label class="mn-prop-label" style="min-width:240px;">Sidebar Navigation Tabs:</label>
		<$select tiddler="$:/config/slipstream/sidebar-tabs-style" default="wrap" class="mn-select">
			<option value="wrap">Wrapping Pills (Default: wraps tabs across lines)</option>
			<option value="scroll">Scrollable Strip (Single horizontal scrolling line)</option>
		</$select>
	</div>
	<div class="mn-object-prop-bar">
		<label class="mn-prop-label" style="min-width:240px;">Wide Layout Filter:</label>
		<$edit-text tiddler="$:/config/slipstream/wide-filter" field="text" default="[tag[Wide]] [field:page-width[wide]]" tag="input" class="mn-search-input"/>
	</div>
	<div class="mn-object-prop-bar">
		<label class="mn-prop-label" style="min-width:240px;">Header Property Fields:</label>
		<$edit-text tiddler="$:/config/slipstream/default-property-fields" field="text" default="status priority mood rating media-type creator due-date" tag="input" class="mn-search-input"/>
	</div>
</div>

<$button class="mn-pill-btn">
	<$action-deletetiddler $filter="[prefix[$:/config/slipstream/]] [prefix[$:/state/slipstream/]] [prefix[$:/config/modern-notebook/]] [prefix[$:/state/modern-notebook/]]"/>
	↺ Reset Slipstream Settings to Defaults
</$button>
